  "query": "SELECT\n  CAST(metric_hour AS VARCHAR) AS metric_hour,\n  order_count,\n  official_paid_revenue,\n  gross_merchandise_value,\n  payment_attempt_count,\n  payment_success_count,\n  checkout_started_count,\n  order_placed_event_count,\n  conversion_rate\nFROM iceberg.gold.agg_hourly_reconciled_kpi\nWHERE metric_hour >= from_iso8601_timestamp('2026-05-01T10:00:00+00:00')\n  AND metric_hour < from_iso8601_timestamp('2026-05-01T11:00:00+00:00')\nORDER BY metric_hour",
