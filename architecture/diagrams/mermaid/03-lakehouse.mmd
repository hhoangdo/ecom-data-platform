%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#f8fbff","primaryTextColor":"#16324f","primaryBorderColor":"#2d6cdf","lineColor":"#5b6b7a","secondaryColor":"#eef6ff","tertiaryColor":"#f7f9fc","fontFamily":"Arial","fontSize":"16px"}}}%%
flowchart LR
    classDef source fill:#e8f1ff,stroke:#2d6cdf,color:#16324f,stroke-width:1.5px;
    classDef compute fill:#eef7ee,stroke:#2f855a,color:#1f4d36,stroke-width:1.5px;
    classDef store fill:#fff7e8,stroke:#c2871a,color:#6c4a00,stroke-width:1.5px;
    classDef serve fill:#f3ecff,stroke:#7a4dd8,color:#4b2d91,stroke-width:1.5px;
    classDef evidence fill:#fff0f3,stroke:#d14b73,color:#7f1d3d,stroke-width:1.5px;

    batch["Batch snapshots<br/>bronze/batch/*"]:::source
    events["Kafka replay logs<br/>bronze/events/*"]:::source
    bronze["MinIO Bronze bucket<br/>source-fidelity landing"]:::store
    silver["Iceberg Silver<br/>typed staging tables"]:::store
    gold["Iceberg Gold<br/>canonical business tables"]:::store
    hive["Hive Metastore"]:::compute
    pg["Shared Postgres<br/>metastore backing DB"]:::store
    trino["Trino SQL<br/>iceberg.silver / iceberg.gold"]:::serve
    state["Checkpoints + evidence buckets"]:::evidence

    batch --> bronze
    events --> bronze
    bronze --> silver
    silver --> gold
    silver --> hive
    gold --> hive
    hive --> pg
    gold --> trino
    state -. runtime metadata .-> hive
