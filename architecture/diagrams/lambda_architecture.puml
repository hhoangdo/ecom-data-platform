@startuml
title Vina Bim Shop Data Platform Architecture - Runnable Services

skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 180

actor "Executive Teams\n1-hour KPI consumption" as Executive
actor "BI/Livestreaming Teams\nreal-time visibility" as BI

rectangle "Source Systems" as Sources {
  component "Python generator\nsynthetic marketplace data" as Generator
  component "Periodic table-state exports\ncustomers, sellers, products,\norders, payments, shipments" as Offline
  component "JSON event producer\nbusiness event envelopes" as Producer
}

rectangle "Ingestion" as Ingestion {
  component "Schema Registry\nJSON Schema subjects" as SchemaRegistry
  queue "Kafka KRaft\nsource topics:\ncommerce_events, catalog_events,\nfulfillment_events, ops_events,\ndead_letter_events" as Kafka
  component "Kafka Connect S3 sink\nlands replay logs" as KafkaConnect
}

rectangle "Lakehouse And Batch" as Lakehouse {
  component "Spark Batch Path\nhourly validation, dedup,\nSilver/Gold Iceberg writer,\nGX and dbt parity checks" as Spark
  database "MinIO Medallion Lakehouse\nBronze batch: Parquet snapshots\nBronze event: JSONL replay logs\nSilver/Gold: curated tables\nIceberg, checkpoints, evidence" as MinIO
  database "Hive Metastore\ncatalog only" as Hive
  database "dbt-DuckDB\nlocal parity oracle" as Dbt
}

rectangle "Realtime Path" as Streaming {
  component "Flink Streaming Path\nevent-time metrics,\nallowed lateness,\nreal-time revenue/issues/anomalies" as Flink
  queue "Derived Kafka topics\nrealtime_commerce_metrics_1m\nrealtime_ops_alerts\nrealtime_metric_corrections" as DerivedKafka
}

rectangle "Serving" as Serving {
  component "Trino SQL Serving\ncanonical hourly SQL\nGold KPI truth" as Trino
  component "Apache Pinot\nRealtime serving sink\nfresh and provisional\nmetrics / alerts" as Realtime
  database "DuckDB executive mart\nlocal KPI mart" as DuckDB
}

rectangle "Control Plane" as Control {
  component "Airflow\nbatch/control-plane DAGs\nno Flink restarts" as Airflow
  component "Great Expectations\nquality gates\nand Data Docs" as GX
}

rectangle "Governance" as Gov {
  component "DataHub\nmetadata, lineage,\nglossary, tags" as DataHub
}

component "Evidence Package\nhealth, screenshots,\nrow counts, reconciliation" as Evidence

Generator --> Offline : writes source snapshots
Generator --> Producer : emits topic-shaped events
Offline --> MinIO : Parquet snapshots: checkpointed table state
Producer --> Kafka : JSON envelope events
SchemaRegistry --> Kafka : JSON Schema contracts
Kafka --> KafkaConnect : source topics
KafkaConnect --> MinIO : JSONL event log: replayable business events

MinIO --> Spark : hourly batch reads landed Bronze data
Spark --> MinIO : curated Silver/Gold tables
MinIO --> Hive : table registration for curated lakehouse tables
Hive --> Trino : catalog metadata
Trino --> DuckDB : Trino Gold snapshot export
DuckDB --> Executive : local KPI mart
Trino --> Executive : canonical hourly SQL dashboards
Trino --> BI : reconciled historical SQL

Kafka --> Flink : direct real-time consumption
Flink --> DerivedKafka : metrics / alerts / corrections
Flink --> MinIO : checkpoints and audit JSONL
DerivedKafka --> Realtime : consume derived topics
Realtime --> BI : live operations

Airflow --> Spark : orchestrates batch jobs
Airflow --> GX : triggers quality gates
Airflow --> DataHub : DataHub ingestion jobs
GX --> DataHub : publishes quality metadata
Trino --> DataHub : table lineage
DataHub --> Evidence : lineage evidence
Trino --> Evidence : KPI query outputs
Realtime --> Evidence : dashboard query outputs

note bottom of MinIO
Truth policy:
Spark/Iceberg/Trino Gold is official KPI truth.
Pinot is fresh and provisional.
dbt-DuckDB remains a local compatibility and parity-testing path.
See architecture/decisions/ for the full ADR roadmap.
end note

@enduml
