{
  "tableName": "pinot_realtime_metric_corrections",
  "tableType": "REALTIME",
  "segmentsConfig": {
    "timeColumnName": "metric_minute_ts",
    "timeType": "MILLISECONDS",
    "replicasPerPartition": "1",
    "retentionTimeUnit": "DAYS",
    "retentionTimeValue": "7"
  },
  "tableIndexConfig": {
    "loadMode": "MMAP",
    "invertedIndexColumns": [
      "metric_key",
      "correction_reason",
      "primary_category",
      "source",
      "device_type",
      "payment_method",
      "order_status"
    ]
  },
  "fieldConfigList": [
    {"name": "metric_minute_ts", "encodingType": "RAW", "indexType": "RANGE"},
    {"name": "revenue_amount", "encodingType": "RAW"},
    {"name": "gmv_proxy_amount", "encodingType": "RAW"}
  ],
  "tenants": {},
  "metadata": {
    "customConfigs": {
      "truth_policy": "provisional_pinot_correction_audit"
    }
  },
  "ingestionConfig": {
    "streamIngestionConfig": {
      "streamConfigMaps": [
        {
          "streamType": "kafka",
          "stream.kafka.topic.name": "realtime_metric_corrections",
          "stream.kafka.broker.list": "kafka:29092",
          "stream.kafka.consumer.type": "lowlevel",
          "stream.kafka.consumer.prop.auto.offset.reset": "smallest",
          "stream.kafka.consumer.factory.class.name": "org.apache.pinot.plugin.stream.kafka30.KafkaConsumerFactory",
          "stream.kafka.decoder.class.name": "org.apache.pinot.plugin.inputformat.json.JSONMessageDecoder",
          "stream.kafka.decoder.prop.format": "JSON",
          "realtime.segment.flush.threshold.rows": "0",
          "realtime.segment.flush.threshold.segment.rows": "50000",
          "realtime.segment.flush.threshold.time": "1h"
        }
      ]
    },
    "transformConfigs": [
      {"columnName": "metric_key", "transformFunction": "JSONPATHSTRING(metric_snapshot, '$.metric_key')"},
      {"columnName": "metric_minute", "transformFunction": "JSONPATHSTRING(metric_snapshot, '$.metric_minute')"},
      {
        "columnName": "metric_minute_ts",
        "transformFunction": "fromDateTime(JSONPATHSTRING(metric_snapshot, '$.metric_minute'), 'yyyy-MM-dd''T''HH:mm:ssXXX')"
      },
      {"columnName": "primary_category", "transformFunction": "JSONPATHSTRING(metric_snapshot, '$.primary_category')"},
      {"columnName": "source", "transformFunction": "JSONPATHSTRING(metric_snapshot, '$.source')"},
      {"columnName": "device_type", "transformFunction": "JSONPATHSTRING(metric_snapshot, '$.device_type')"},
      {"columnName": "payment_method", "transformFunction": "JSONPATHSTRING(metric_snapshot, '$.payment_method')"},
      {"columnName": "order_status", "transformFunction": "JSONPATHSTRING(metric_snapshot, '$.order_status')"},
      {"columnName": "schema_version", "transformFunction": "JSONPATHLONG(metric_snapshot, '$.schema_version', 0)"},
      {"columnName": "order_count", "transformFunction": "JSONPATHLONG(metric_snapshot, '$.order_count', 0)"},
      {"columnName": "order_placed_count", "transformFunction": "JSONPATHLONG(metric_snapshot, '$.order_placed_count', 0)"},
      {
        "columnName": "checkout_started_count",
        "transformFunction": "JSONPATHLONG(metric_snapshot, '$.checkout_started_count', 0)"
      },
      {
        "columnName": "payment_failure_count",
        "transformFunction": "JSONPATHLONG(metric_snapshot, '$.payment_failure_count', 0)"
      },
      {"columnName": "revenue_amount", "transformFunction": "JSONPATHDOUBLE(metric_snapshot, '$.revenue_amount', 0.0)"},
      {"columnName": "gmv_proxy_amount", "transformFunction": "JSONPATHDOUBLE(metric_snapshot, '$.gmv_proxy_amount', 0.0)"},
      {
        "columnName": "checkout_conversion_rate",
        "transformFunction": "JSONPATHDOUBLE(metric_snapshot, '$.checkout_conversion_rate', 0.0)"
      },
      {"columnName": "late_event_count", "transformFunction": "JSONPATHLONG(metric_snapshot, '$.late_event_count', 0)"},
      {
        "columnName": "duplicate_event_count",
        "transformFunction": "JSONPATHLONG(metric_snapshot, '$.duplicate_event_count', 0)"
      },
      {"columnName": "watermark_ts", "transformFunction": "JSONPATHSTRING(metric_snapshot, '$.watermark_ts')"},
      {"columnName": "emitted_ts", "transformFunction": "JSONPATHSTRING(metric_snapshot, '$.emitted_ts')"}
    ],
    "continueOnError": true,
    "rowTimeValueCheck": true,
    "segmentTimeValueCheck": false
  },
  "isDimTable": false
}
