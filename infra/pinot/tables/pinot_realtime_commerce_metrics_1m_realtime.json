{
  "tableName": "pinot_realtime_commerce_metrics_1m",
  "tableType": "REALTIME",
  "segmentsConfig": {
    "timeColumnName": "metric_minute_ts",
    "timeType": "MILLISECONDS",
    "replicasPerPartition": "1",
    "retentionTimeUnit": "DAYS",
    "retentionTimeValue": "7"
  },
  "tableIndexConfig": {
    "loadMode": "MMAP",
    "invertedIndexColumns": [
      "primary_category",
      "source",
      "device_type",
      "payment_method",
      "order_status",
      "schema_version"
    ]
  },
  "fieldConfigList": [
    {"name": "metric_minute_ts", "encodingType": "RAW", "indexType": "RANGE"},
    {"name": "revenue_amount", "encodingType": "RAW"},
    {"name": "gmv_proxy_amount", "encodingType": "RAW"}
  ],
  "tenants": {},
  "metadata": {
    "customConfigs": {
      "truth_policy": "provisional_pinot_live_metrics"
    }
  },
  "ingestionConfig": {
