          "realtime.segment.flush.threshold.time": "1h"
        }
      ]
    },
    "transformConfigs": [
      {
        "columnName": "metric_minute_ts",
        "transformFunction": "fromDateTime(metric_minute, 'yyyy-MM-dd''T''HH:mm:ssXXX')"
      }
